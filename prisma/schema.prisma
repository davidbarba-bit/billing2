// mini-Lago Prisma schema — v3 redesign.
//
// Key change vs v2: invoices are now per Customer (not per Service). A
// customer's invoice aggregates fees from ALL of its active services
// (monthly + setup + service-level per-unit add-ons) plus its own flat
// customer-level add-ons. The billing cycle (calendar / anniversary) lives
// on the Customer, not the Service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization (tenant).
// ---------------------------------------------------------------------------

model Organization {
  id                     String   @id @default(uuid())
  slug                   String   @unique
  name                   String
  timezone               String   @default("UTC")
  apiKey                 String   @unique @map("api_key")
  netsuiteAccountId      String?  @map("netsuite_account_id")
  netsuiteConsumerKey    String?  @map("netsuite_consumer_key")
  netsuiteConsumerSecret String?  @map("netsuite_consumer_secret")
  netsuiteTokenKey       String?  @map("netsuite_token_key")
  netsuiteTokenSecret    String?  @map("netsuite_token_secret")
  netsuiteRestBase       String?  @map("netsuite_rest_base")
  netsuiteCallbackSecret String?  @map("netsuite_callback_secret")
  // v24: config extra para el dispatch de factura estándar (subsidiaria,
  // modo de referencia de entity/item, mapeo de moneda). Bag JSON para
  // iterar contra el sandbox sin migraciones nuevas. Shape esperado:
  //   { subsidiaryId?: string, entityRefMode?: 'internal'|'external',
  //     itemRefMode?: 'internal'|'external', currencyRef?: {MXN: '1', USD: '2'},
  //     department?: string, location?: string }
  netsuiteConfig         Json     @default("{}") @map("netsuite_config")
  customerCounter        Int      @default(0) @map("customer_counter")
  invoiceCounter         Int      @default(0) @map("invoice_counter")
  creditNoteCounter      Int      @default(0) @map("credit_note_counter")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  customers       Customer[]
  services        Service[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  events          EventLog[]
  idempotencyKeys IdempotencyRecord[]
  catalogEvents   CatalogEvent[]
  catalogEventOccurrences CatalogEventOccurrence[]
  customerCatalogEventPricings CustomerCatalogEventPricing[]
  taxEntities     TaxEntity[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Customer — owns the billing cycle.
// ---------------------------------------------------------------------------

model Customer {
  id                            String    @id @default(uuid())
  organizationId                String    @map("organization_id")
  externalId                    String    @map("external_id")
  sequentialId                  Int       @map("sequential_id")
  slug                          String
  name                          String
  email                         String?
  phone                         String?
  currency                      String
  timezone                      String?
  // v4: billing cycle anclado a día N + intervalo configurable. Eliminamos
  // `billing_time` (calendar/anniversary) — siempre es calendario con día N.
  billingPeriodMonths           Int       @default(1) @map("billing_period_months") // 1 | 3 | 6 | 12
  billingAnchorDay              Int       @default(1) @map("billing_anchor_day") // 1..28
  // v15: mes ancla del ciclo (1..12). Solo aplica si billing_period_months > 1.
  // NULL → comportamiento legacy (anclado al mes de subscription_at).
  // Si está set: cycles arrancan en {anchor_month + k * period_months} mod 12.
  // Ej: trimestral con anchor_month=1 → Ene/Abr/Jul/Oct cycles.
  billingAnchorMonth            Int?      @map("billing_anchor_month")
  // Cómo cobrar units de servicios one-off cuando entran (primer ping):
  //   "immediate"   → 1 invoice por ping, emitida al instante del POST /events
  //   "next_cycle"  → unit pendiente hasta el cierre del ciclo, sale en la cycle invoice del customer
  nonrecurringTrigger           String    @default("next_cycle") @map("nonrecurring_trigger")
  // v19: estructura de la cycle invoice al cierre de ciclo.
  //   "unified" (default) → 1 invoice con TODOS los conceptos (renta + setup +
  //                         removal + addons + mensualidades prepagadas one_off).
  //                         Backward compat 100%.
  //   "split_by_kind"     → hasta 2 invoices: una con conceptos RECURRENTES
  //                         (monthly, service_addon, customer_addon, one_off
  //                         prepagado = renta) y otra con conceptos ÚNICOS
  //                         (setup, removal). Útil para clientes contables que
  //                         requieren separar movimientos operativos de
  //                         instalaciones/bajas.
  cycleInvoiceMode              String    @default("unified") @map("cycle_invoice_mode")
  subscriptionAt                DateTime  @map("subscription_at")
  startedAt                     DateTime? @map("started_at")
  terminatedAt                  DateTime? @map("terminated_at")
  currentBillingPeriodStartedAt DateTime? @map("current_billing_period_started_at")
  currentBillingPeriodEndingAt  DateTime? @map("current_billing_period_ending_at")
  // v22: la identidad fiscal (RFC, dirección, netsuite_internal_id) vive en
  // TaxEntity (razones sociales). El Customer es solo la cuenta comercial.
  status                        String    @default("active") // pending | active | terminated
  metadata                      Json      @default("{}")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]
  addOns       CustomerAddOn[]
  invoices     Invoice[]
  creditNotes  CreditNote[]
  catalogEventOccurrences CatalogEventOccurrence[]
  catalogEventPricings    CustomerCatalogEventPricing[]
  taxEntities  TaxEntity[]

  @@unique([organizationId, externalId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Tax handling — desde v5 mini-Lago NO calcula impuestos. Las invoices se
// envían a NetSuite con montos netos por partida; NetSuite aplica los
// impuestos que tenga configurados para cada cliente (incluyendo IVA MX
// 16%, IEPS, retenciones, etc.) y emite el CFDI con esas particularidades.
// El RFC del cliente (`tax_identification_number` en Customer) sigue siendo
// metadata fiscal que se le pasa a NetSuite.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Service — owns units + per-unit pricing. Does NOT own billing cycle (the
// customer does, since one invoice aggregates many services).
// ---------------------------------------------------------------------------

model Service {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  customerId             String    @map("customer_id")
  code                   String
  name                   String
  description            String?
  currency               String
  // v4: pricing_model decide cómo se cobra.
  //   "recurring" → renta per_unit (monthlyUnitAmountCents) cada periodo del customer
  //                 + setup opcional (setupUnitAmountCents) una vez por unit.
  //                 + baja opcional (removalUnitAmountCents) una vez al terminar.
  //                 Setup y baja tienen control independiente de "cuándo facturar"
  //                 a nivel Service (setupBillingMode / removalBillingMode).
  //   "one_off"   → bloque cobrado al primer evento de cada unit:
  //                   · setup opcional (setupUnitAmountCents) — sí aplica.
  //                   · N mensualidades prepagadas (N × monthlyUnitAmountCents)
  //                     donde N = unit.prepaidMonths ?? service.prepaidMonthsDefault.
  //                 El "cuándo" del bloque entero lo decide
  //                 Customer.nonrecurringTrigger (next_cycle vs immediate).
  //                 removalUnitAmountCents NO aplica (no hay baja en one_off).
  pricingModel           String    @default("recurring") @map("pricing_model")
  monthlyUnitAmountCents Int       @default(0) @map("monthly_unit_amount_cents")
  setupUnitAmountCents   Int       @default(0) @map("setup_unit_amount_cents")
  // v9: códigos de producto NetSuite por kind de fee.
  //   - netsuiteMonthlyItemCode → para fees kind=monthly (recurring) Y para
  //     fees kind=one_off (mensualidades prepagadas de un service one_off,
  //     conceptualmente la misma renta mensual cobrada por anticipado).
  //   - netsuiteSetupItemCode   → para fees kind=setup (cargo único per-unit).
  // Si falta un código al emitir, la Fee se persiste con netsuite_item_code=null
  // y el dispatch a NetSuite probablemente fallará (NetSuite no podrá mapear
  // la línea a su catálogo). La preview muestra advertencia visual.
  netsuiteMonthlyItemCode String? @map("netsuite_monthly_item_code")
  netsuiteSetupItemCode   String? @map("netsuite_setup_item_code")
  // v17: cobro de "baja" (desinstalación) — se dispara cuando una unit termina
  // (activeTo != null) y aparece en el invoice del period que contiene la
  // terminación. Default 0 = sin cargo de baja. Solo aplica a pricing_model=
  // recurring (one_off no tiene mensualidades a las que sumar). NO se dispara
  // en migración de plan (esa flujo setea removalBilledAt en la unit vieja).
  removalUnitAmountCents  Int     @default(0) @map("removal_unit_amount_cents")
  netsuiteRemovalItemCode String? @map("netsuite_removal_item_code")
  // v18: política de cuándo se emite el invoice del setup/baja.
  //   "next_cycle" (default) → el cargo entra al próximo cycle invoice junto
  //                            con la mensualidad. Backward compat.
  //   "immediate"            → se emite invoice independiente al instalar/dar
  //                            de baja la unit (similar a one_off immediate).
  // Útil para que Numaris cobre la instalación física al instante (cash flow
  // del costo de visita técnica) y la renta consolide al fin de mes.
  setupBillingMode   String @default("next_cycle") @map("setup_billing_mode")
  removalBillingMode String @default("next_cycle") @map("removal_billing_mode")
  // v7: cambio de precio programado. Cuando los tres campos están poblados y
  // el periodo a facturar empieza on-or-after `pendingEffectiveFrom`, el motor
  // usa los valores `pending*` en lugar de los de arriba. Aplica igual para
  // recurring y one_off (mensualidades prepagadas aún no facturadas usan el
  // precio vigente al momento de emitir la cycle invoice).
  pendingMonthlyUnitAmountCents Int?      @map("pending_monthly_unit_amount_cents")
  pendingSetupUnitAmountCents   Int?      @map("pending_setup_unit_amount_cents")
  pendingEffectiveFrom          DateTime? @map("pending_effective_from")
  // Default de meses prepagados por unit (solo aplica a pricing_model=one_off).
  // Puede ser sobreescrito a nivel Unit (Unit.prepaidMonths). Si ambos son
  // null al momento de facturar, se aborta el cobro con un error.
  prepaidMonthsDefault   Int?      @map("prepaid_months_default")
  status                 String    @default("active") // active | terminated
  terminatedAt           DateTime? @map("terminated_at")
  // v22: razón social a la que se factura este plan. Hereda la default del
  // cliente al crearse; la fase 2 permite elegir otra.
  taxEntityId            String    @map("tax_entity_id")
  metadata               Json      @default("{}")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taxEntity    TaxEntity      @relation(fields: [taxEntityId], references: [id])
  units        Unit[]
  addOns       ServiceAddOn[]
  events       EventLog[]
  fees         Fee[]

  @@unique([organizationId, code])
  @@index([customerId])
  @@map("services")
}

// ---------------------------------------------------------------------------
// ServiceAddOn — per-unit recurring modifier attached to a Service.
// Ej: "+$50/u por historial 12 meses".
// ---------------------------------------------------------------------------

model ServiceAddOn {
  id          String    @id @default(uuid())
  serviceId   String    @map("service_id")
  code        String
  name        String
  description String?
  amountCents Int       @map("amount_cents")
  // v9: código NetSuite que mapea este add-on per-unit a un item del catálogo.
  netsuiteItemCode String? @map("netsuite_item_code")
  activeFrom  DateTime  @map("active_from")
  activeTo    DateTime? @map("active_to")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  fees    Fee[]

  @@unique([serviceId, code])
  @@index([serviceId, activeTo])
  @@map("service_add_ons")
}

// ---------------------------------------------------------------------------
// CustomerAddOn — flat recurring modifier attached to a Customer.
// Ej: "+$1000/mes por 10 reglas de evento" (independiente de services o
// unidades).
// ---------------------------------------------------------------------------

model CustomerAddOn {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  code        String
  name        String
  description String?
  amountCents Int       @map("amount_cents")
  // v9: código NetSuite del item asociado a este customer add-on flat.
  netsuiteItemCode String? @map("netsuite_item_code")
  activeFrom  DateTime  @map("active_from")
  activeTo    DateTime? @map("active_to")
  // v22: razón social a la que se factura este add-on flat.
  taxEntityId String    @map("tax_entity_id")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taxEntity TaxEntity @relation(fields: [taxEntityId], references: [id])
  fees      Fee[]

  @@unique([customerId, code])
  @@index([customerId, activeTo])
  @@map("customer_add_ons")
}

// ---------------------------------------------------------------------------
// Unit — materialised, no event-replay.
// ---------------------------------------------------------------------------

model Unit {
  id            String    @id @default(uuid())
  serviceId     String    @map("service_id")
  externalId    String    @map("external_id")
  label         String?
  activeFrom    DateTime  @map("active_from")
  activeTo      DateTime? @map("active_to")
  // v8: opcional override para "cuándo empieza a facturarse" la unit.
  //   - NULL  → el motor usa activeFrom (comportamiento default).
  //   - <set> → el motor usa este valor en lugar de activeFrom para
  //             proration mensual, gates de setup y filtros de one_off.
  // Útil para migración desde otras plataformas: la unit reporta desde
  // activeFrom (verdad operativa) pero se factura desde billing_starts_at.
  //   Cobrar mes completo aunque entre mid-mes → billing_starts_at = inicio del mes
  //   Saltarse el mes (ya pagó en otra plataforma) → billing_starts_at = inicio del próximo mes
  billingStartsAt DateTime? @map("billing_starts_at")
  // Gates de cobro one-off por unit:
  //   setupBilledAt    → para services recurring + setup_unit_amount_cents > 0
  //   oneoffBilledAt   → para services one_off (la unit no vuelve a aparecer en facturas)
  //   removalBilledAt  → v17: cobro de baja al terminar la unit. NULL = pendiente
  //                      (si la unit todavía no termina, o terminó pero aún no
  //                      se cierra el ciclo). Setteado a la fecha de baja para
  //                      neutralizar el cargo en flujos de migración (planos donde
  //                      la baja no es una desinstalación real sino transferencia).
  setupBilledAt   DateTime? @map("setup_billed_at")
  oneoffBilledAt  DateTime? @map("oneoff_billed_at")
  removalBilledAt DateTime? @map("removal_billed_at")
  // Meses prepagados para esta unit (override del default del Service). Solo
  // aplica si el Service es one_off. Cuando la unit se factura por primera vez,
  // se cobra setup + N × monthly y la unit queda marcada con oneoffBilledAt.
  prepaidMonths Int?      @map("prepaid_months")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  events  EventLog[]

  @@unique([serviceId, externalId])
  @@index([serviceId, activeTo])
  @@map("units")
}

// ---------------------------------------------------------------------------
// EventLog — append-only audit.
// ---------------------------------------------------------------------------

model EventLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  transactionId  String   @map("transaction_id")
  serviceId      String   @map("service_id")
  unitId         String?  @map("unit_id")
  unitExternalId String   @map("unit_external_id")
  unitLabel      String?  @map("unit_label")
  operationType  String   @map("operation_type") // add | remove
  kind           String?
  timestamp      DateTime
  properties     Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id])

  @@unique([organizationId, transactionId])
  @@index([serviceId, timestamp])
  @@map("event_log")
}

// ---------------------------------------------------------------------------
// Invoice — per Customer per Period.
//
// Contains fees from all the customer's active services + customer-level
// add-ons. No serviceId at the invoice level (fees reference services and
// add-ons explicitly).
// ---------------------------------------------------------------------------

model Invoice {
  id                                String    @id @default(uuid())
  organizationId                    String    @map("organization_id")
  customerId                        String    @map("customer_id")
  sequentialId                      Int       @map("sequential_id")
  number                            String?
  issuingDate                       DateTime  @map("issuing_date") @db.Date
  paymentDueDate                    DateTime  @map("payment_due_date") @db.Date
  netPaymentTerm                    Int       @default(0) @map("net_payment_term")
  status                            String    @default("calculated") // calculated | finalized | voided
  externalDispatchStatus            String    @default("pending") @map("external_dispatch_status")
  externalDispatchError             String?   @map("external_dispatch_error")
  paymentStatus                     String    @default("pending") @map("payment_status")
  currency                          String
  // Total neto sin impuestos. NetSuite calcula y agrega los taxes que
  // correspondan al cliente cuando genera el CFDI.
  feesAmountCents                   Int       @default(0) @map("fees_amount_cents")
  periodFrom                        DateTime? @map("period_from")
  periodTo                          DateTime? @map("period_to")
  metadata                          Json      @default("{}")
  unitsAnnex                        Json      @default("[]") @map("units_annex")
  idempotencyKey                    String?   @map("idempotency_key")
  externalInvoiceFolio              String?   @map("external_invoice_folio")
  externalInvoiceUuidCfdi           String?   @map("external_invoice_uuid_cfdi")
  externalInvoiceSystem             String?   @map("external_invoice_system")
  externalInvoiceNetsuiteInternalId String?   @map("external_invoice_netsuite_internal_id")
  externalInvoicePdfUrl             String?   @map("external_invoice_pdf_url")
  externalInvoiceXmlUrl             String?   @map("external_invoice_xml_url")
  externalInvoiceIssuedAt           DateTime? @map("external_invoice_issued_at")
  externalInvoiceConfirmedAt        DateTime? @map("external_invoice_confirmed_at")
  externalInvoiceDueDate            DateTime? @map("external_invoice_due_date") @db.Date
  netsuiteDispatchId                String?   @map("netsuite_dispatch_id")
  // v22: razón social receptora de esta factura. Una factura = una razón
  // social (un RFC). La fase 3 agrupa las fees por razón social para emitir
  // una factura por entidad; hoy hereda la default del cliente.
  taxEntityId                       String    @map("tax_entity_id")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  taxEntity    TaxEntity    @relation(fields: [taxEntityId], references: [id])
  fees         Fee[]
  creditNotes  CreditNote[]

  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Fee — line item on an invoice.
//
// `kind`:
//   "monthly"        per_unit base monthly fee (1 per service per invoice)
//   "setup"          per_unit one-off setup fee (1 per service per invoice)
//   "service_addon"  per_unit recurring add-on on a service
//   "customer_addon" flat recurring add-on on the customer
// ---------------------------------------------------------------------------

model Fee {
  id                String   @id @default(uuid())
  invoiceId         String   @map("invoice_id")
  serviceId         String?  @map("service_id")
  serviceAddOnId    String?  @map("service_add_on_id")
  customerAddOnId   String?  @map("customer_add_on_id")
  kind              String
  description       String?
  units             String
  unitAmountCents   Int      @map("unit_amount_cents")
  preciseUnitAmount String   @map("precise_unit_amount")
  // Monto neto sin impuestos. NetSuite calcula los taxes para el CFDI.
  amountCents       Int      @map("amount_cents")
  // v9: snapshot del código NetSuite resuelto al emitir la fee. Cambios
  // posteriores en la fuente (Service/AddOn) no afectan invoices ya emitidas.
  // null = no se configuró código en la fuente al momento de emitir.
  netsuiteItemCode  String?  @map("netsuite_item_code")
  billedUnitsDetail Json     @default("[]") @map("billed_units_detail")
  paymentStatus     String   @default("pending") @map("payment_status")
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")

  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service         Service?         @relation(fields: [serviceId], references: [id])
  serviceAddOn    ServiceAddOn?    @relation(fields: [serviceAddOnId], references: [id])
  customerAddOn   CustomerAddOn?   @relation(fields: [customerAddOnId], references: [id])
  cnItems         CreditNoteItem[]
  catalogEventOccurrence CatalogEventOccurrence?

  @@index([invoiceId])
  @@map("fees")
}

// ---------------------------------------------------------------------------
// Credit note.
// ---------------------------------------------------------------------------

model CreditNote {
  id                                String    @id @default(uuid())
  organizationId                    String    @map("organization_id")
  customerId                        String    @map("customer_id")
  invoiceId                         String    @map("invoice_id")
  sequentialId                      Int       @map("sequential_id")
  number                            String?
  status                            String    @default("calculated")
  externalDispatchStatus            String    @default("pending") @map("external_dispatch_status")
  externalDispatchError             String?   @map("external_dispatch_error")
  creditStatus                      String    @default("available") @map("credit_status")
  refundStatus                      String?   @map("refund_status")
  reason                            String
  description                       String?
  currency                          String
  // Monto neto sin impuestos (NetSuite calcula los taxes para el CFDI).
  totalAmountCents                  Int       @map("total_amount_cents")
  balanceAmountCents                Int       @map("balance_amount_cents")
  creditAmountCents                 Int       @map("credit_amount_cents")
  refundAmountCents                 Int       @default(0) @map("refund_amount_cents")
  fileUrl                           String?   @map("file_url")
  issuingDate                       DateTime  @map("issuing_date") @db.Date
  idempotencyMarker                 String?   @map("idempotency_marker")
  externalCreditNoteFolio           String?   @map("external_credit_note_folio")
  externalCreditNoteUuidCfdi        String?   @map("external_credit_note_uuid_cfdi")
  externalCreditNoteSystem          String?   @map("external_credit_note_system")
  externalCreditNoteNetsuiteId      String?   @map("external_credit_note_netsuite_id")
  externalCreditNotePdfUrl          String?   @map("external_credit_note_pdf_url")
  externalCreditNoteXmlUrl          String?   @map("external_credit_note_xml_url")
  externalCreditNoteIssuedAt        DateTime? @map("external_credit_note_issued_at")
  externalCreditNoteConfirmedAt     DateTime? @map("external_credit_note_confirmed_at")
  netsuiteDispatchId                String?   @map("netsuite_dispatch_id")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id])
  invoice      Invoice          @relation(fields: [invoiceId], references: [id])
  items        CreditNoteItem[]

  @@map("credit_notes")
}

model CreditNoteItem {
  id             String   @id @default(uuid())
  creditNoteId   String   @map("credit_note_id")
  feeId          String   @map("fee_id")
  amountCents    Int      @map("amount_cents")
  amountCurrency String   @map("amount_currency")
  createdAt      DateTime @default(now()) @map("created_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  fee        Fee        @relation(fields: [feeId], references: [id])

  @@map("credit_note_items")
}

// ---------------------------------------------------------------------------
// Idempotency.
// ---------------------------------------------------------------------------

model IdempotencyRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  path           String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, path, key])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// Cuestionario público de migración. Respuestas del equipo comercial sobre
// cómo se debe configurar una cuenta. Payload es schema-flexible: el form
// puede iterar libremente sin requerir nuevas migraciones.
// ---------------------------------------------------------------------------

model MigrationQuestionnaire {
  id            String   @id @default(uuid())
  filledByName  String   @map("filled_by_name")
  filledByEmail String?  @map("filled_by_email")
  customerLabel String   @map("customer_label")
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("migration_questionnaire")
}

// ---------------------------------------------------------------------------
// v22: Razón social (entidad fiscal). Un cliente comercial (Customer) puede
// facturar a varias razones sociales — cada una es el receptor fiscal de un
// CFDI (un RFC por factura). La identidad fiscal vive aquí, NO en el Customer:
// el Customer es la cuenta comercial dueña de la relación, el ciclo y la
// moneda; cada plan/add-on/evento se factura a una de sus razones sociales.
// Todas las razones sociales de un cliente comparten el ciclo del Customer.
// ---------------------------------------------------------------------------

model TaxEntity {
  id                      String   @id @default(uuid())
  organizationId          String   @map("organization_id")
  customerId              String   @map("customer_id")
  // v22/fase5: identificador externo estable de ESTA razón social (no del
  // cliente comercial). Es el handle que se envía a NetSuite como external
  // id del customer (NetSuite ve cada razón social como un customer
  // distinto). Default = el external_id del cliente; las razones sociales
  // adicionales reciben uno explícito (slug ASCII único por organization).
  externalId              String   @map("external_id")
  // Razón social oficial (como aparece en la Constancia de Situación Fiscal).
  legalName               String   @map("legal_name")
  taxIdentificationNumber String?  @map("tax_identification_number") // RFC
  taxRegime               String?  @map("tax_regime")                // código SAT régimen
  cfdiUse                 String?  @map("cfdi_use")                   // uso CFDI default
  email                   String?                                    // correo fiscal
  addressLine1            String?  @map("address_line1")
  addressLine2            String?  @map("address_line2")
  state                   String?
  zipcode                 String?
  city                    String?
  country                 String?
  // v13/v22: internal id de NetSuite — cada razón social = un customer en
  // NetSuite. Si está vacío el dispatch usa "eid:<external_id>" (el de la
  // razón social, no el del cliente comercial).
  netsuiteInternalId      String?  @map("netsuite_internal_id")
  // Una (y solo una) razón social del cliente es la default — la que heredan
  // los planes/add-ons al crearse si no se especifica otra.
  isDefault               Boolean  @default(false) @map("is_default")
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer                Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  services                Service[]
  customerAddOns          CustomerAddOn[]
  catalogEventOccurrences CatalogEventOccurrence[]
  invoices                Invoice[]

  @@unique([organizationId, externalId])
  @@index([organizationId, customerId])
  @@map("tax_entities")
}

// ---------------------------------------------------------------------------
// v21: catálogo de eventos únicos facturables (revisión de dispositivo,
// capacitación, reinstalación, etc.). El catálogo lo gestiona el admin de la
// organización; las ocurrencias se crean por API y se materializan como una
// fee kind='catalog_event' en una invoice — inmediata o en el próximo ciclo.
// ---------------------------------------------------------------------------

model CatalogEvent {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  code               String
  name               String
  description        String?
  defaultAmountCents Int?     @map("default_amount_cents")
  // Default usado como semilla al crear pricing por cliente; el precio real
  // que se cobra al registrar una ocurrencia siempre viene de
  // CustomerCatalogEventPricing, no de aquí.
  defaultBillingMode String   @default("next_cycle") @map("default_billing_mode")
  netsuiteItemCode   String?  @map("netsuite_item_code")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  occurrences  CatalogEventOccurrence[]
  customerPricings CustomerCatalogEventPricing[]

  @@unique([organizationId, code])
  @@map("catalog_events")
}

// Precio pactado por cliente para un evento del catálogo. El registro de una
// ocurrencia (POST /api/v1/catalog-events/occurrences) toma de aquí amount +
// billing_mode — no del request body. Si no hay pricing configurado para el
// par (customer, catalog_event), el handler rechaza la ocurrencia con
// `customer_catalog_event_pricing_not_set`.
model CustomerCatalogEventPricing {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  customerId      String   @map("customer_id")
  catalogEventId  String   @map("catalog_event_id")
  amountCents     Int      @map("amount_cents")
  billingMode     String   @map("billing_mode") // immediate | next_cycle
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  catalogEvent CatalogEvent @relation(fields: [catalogEventId], references: [id], onDelete: Cascade)

  @@unique([customerId, catalogEventId])
  @@index([organizationId])
  @@map("customer_catalog_event_pricing")
}

model CatalogEventOccurrence {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  catalogEventId  String   @map("catalog_event_id")
  customerId      String   @map("customer_id")
  // Texto libre — referencia a una unidad por external_id si la ocurrencia
  // está asociada a una unidad específica (ej. "reinstalación de gps-001").
  // No es FK porque el evento puede aplicar a un dispositivo de un sistema
  // externo que aún no esté como Unit en Numaris Billing.
  unitExternalId  String?  @map("unit_external_id")
  amountCents     Int      @map("amount_cents")
  // 'immediate' → invoice individual al crear la ocurrencia (igual que setup
  // immediate). 'next_cycle' → queda pendiente y se incluye en la cycle
  // invoice del cliente al cierre del periodo, respetando cycleInvoiceMode.
  billingMode     String   @map("billing_mode")
  reference       String?
  occurredAt      DateTime @map("occurred_at")
  // v22: razón social a la que se factura esta ocurrencia.
  taxEntityId     String   @map("tax_entity_id")
  // Se setea cuando la ocurrencia se materializa en una fee dentro de una
  // invoice. null = aún pendiente de facturar (sólo aplica a billing_mode
  // 'next_cycle'; 'immediate' siempre se materializa de inmediato).
  feeId           String?  @unique @map("fee_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogEvent CatalogEvent @relation(fields: [catalogEventId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taxEntity    TaxEntity    @relation(fields: [taxEntityId], references: [id])
  fee          Fee?         @relation(fields: [feeId], references: [id])

  @@index([organizationId, customerId, billingMode])
  @@map("catalog_event_occurrences")
}
