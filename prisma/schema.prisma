// mini-Lago Prisma schema — Numaris-native model (v2 redesign).
//
// This collapses the original Lago-shaped entities (Plan + Subscription +
// Charge + BillableMetric + AddOn) into a single domain-specific entity:
// `Service`. Units are materialized (not derived from events) so the
// proration math is a simple table scan instead of an event-log replay.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization (tenant).
// ---------------------------------------------------------------------------

model Organization {
  id                     String   @id @default(uuid())
  slug                   String   @unique
  name                   String
  timezone               String   @default("UTC")
  apiKey                 String   @unique @map("api_key")
  netsuiteAccountId      String?  @map("netsuite_account_id")
  netsuiteConsumerKey    String?  @map("netsuite_consumer_key")
  netsuiteConsumerSecret String?  @map("netsuite_consumer_secret")
  netsuiteTokenKey       String?  @map("netsuite_token_key")
  netsuiteTokenSecret    String?  @map("netsuite_token_secret")
  netsuiteRestBase       String?  @map("netsuite_rest_base")
  netsuiteCallbackSecret String?  @map("netsuite_callback_secret")
  customerCounter        Int      @default(0) @map("customer_counter")
  invoiceCounter         Int      @default(0) @map("invoice_counter")
  creditNoteCounter      Int      @default(0) @map("credit_note_counter")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  customers       Customer[]
  taxes           Tax[]
  services        Service[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  events          EventLog[]
  idempotencyKeys IdempotencyRecord[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Customer.
// ---------------------------------------------------------------------------

model Customer {
  id                      String   @id @default(uuid())
  organizationId          String   @map("organization_id")
  externalId              String   @map("external_id")
  sequentialId            Int      @map("sequential_id")
  slug                    String
  name                    String
  email                   String?
  phone                   String?
  taxIdentificationNumber String?  @map("tax_identification_number")
  addressLine1            String?  @map("address_line1")
  addressLine2            String?  @map("address_line2")
  state                   String?
  zipcode                 String?
  city                    String?
  country                 String?
  currency                String
  timezone                String?
  metadata                Json     @default("{}")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxLinks     CustomerTaxLink[]
  services     Service[]
  invoices     Invoice[]
  creditNotes  CreditNote[]

  @@unique([organizationId, externalId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Tax (still a separate entity — Numaris may use IVA + IEPS in the future).
// ---------------------------------------------------------------------------

model Tax {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  description    String?
  rate           Decimal  @db.Decimal(10, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers        CustomerTaxLink[]
  services         ServiceTaxLink[]
  appliedTaxes     AppliedTax[]
  cnAppliedTaxes   CreditNoteAppliedTax[]

  @@unique([organizationId, code])
  @@map("taxes")
}

model CustomerTaxLink {
  customerId String   @map("customer_id")
  taxId      String   @map("tax_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tax      Tax      @relation(fields: [taxId], references: [id], onDelete: Cascade)

  @@id([customerId, taxId])
  @@map("customer_tax_links")
}

// ---------------------------------------------------------------------------
// Service (Servicio) — the Numaris domain entity. Collapses everything that
// used to be Plan + Subscription + Charge + BillableMetric + AddOn.
//
// Each customer can have N services (eg. "Combustible", "Tracking",
// "Telemetría"). A service has:
//   - a monthly per-unit price (`monthlyUnitAmountCents`) — billed prorated
//     by the days each unit was active within the period.
//   - a setup per-unit price (`setupUnitAmountCents`) — billed one-off the
//     first time each unit is invoiced.
//   - a billing rhythm (`billingTime` = calendar | anniversary) and current
//     period dates.
//
// Units are tracked in the `Unit` table; events still flow through
// EventLog as an audit trail but `Unit.activeFrom`/`activeTo` are the
// source of truth.
// ---------------------------------------------------------------------------

model Service {
  id                            String    @id @default(uuid())
  organizationId                String    @map("organization_id")
  customerId                    String    @map("customer_id")
  code                          String
  name                          String
  description                   String?
  currency                      String
  monthlyUnitAmountCents        Int       @default(0) @map("monthly_unit_amount_cents")
  setupUnitAmountCents          Int       @default(0) @map("setup_unit_amount_cents")
  status                        String    @default("active")
  billingTime                   String    @default("calendar") @map("billing_time")
  subscriptionAt                DateTime  @map("subscription_at")
  startedAt                     DateTime? @map("started_at")
  terminatedAt                  DateTime? @map("terminated_at")
  currentBillingPeriodStartedAt DateTime? @map("current_billing_period_started_at")
  currentBillingPeriodEndingAt  DateTime? @map("current_billing_period_ending_at")
  metadata                      Json      @default("{}")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taxLinks     ServiceTaxLink[]
  units        Unit[]
  addOns       AddOn[]
  events       EventLog[]
  invoices     Invoice[]
  fees         Fee[]

  @@unique([organizationId, code])
  @@index([customerId])
  @@map("services")
}

// Service ↔ Tax association. If empty, the customer's tax_codes apply.
// If present, overrides the customer-level taxes.
model ServiceTaxLink {
  serviceId String   @map("service_id")
  taxId     String   @map("tax_id")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tax     Tax     @relation(fields: [taxId], references: [id], onDelete: Cascade)

  @@id([serviceId, taxId])
  @@map("service_tax_links")
}

// ---------------------------------------------------------------------------
// AddOn — recurring modifier attached to a Service (different from the Lago
// AddOn concept that was deleted in v2). Two pricing types today:
//
//   - per_unit_monthly: amount × active_units, prorated by days.
//   - flat_monthly:     amount × prorated days (independent of units).
//
// Lifecycle via activeFrom/activeTo so add-ons can be enabled mid-period
// and the engine will prorate them correctly.
// ---------------------------------------------------------------------------

model AddOn {
  id          String    @id @default(uuid())
  serviceId   String    @map("service_id")
  code        String
  name        String
  description String?
  pricingType String    @map("pricing_type") // "per_unit_monthly" | "flat_monthly"
  amountCents Int       @map("amount_cents")
  activeFrom  DateTime  @map("active_from")
  activeTo    DateTime? @map("active_to")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  fees    Fee[]

  @@unique([serviceId, code])
  @@index([serviceId, activeTo])
  @@map("add_ons")
}

// ---------------------------------------------------------------------------
// Unit (Unidad) — materialised state, not derived from events.
//
// `activeFrom` = first observed `add` event (or manual creation).
// `activeTo` = null while the unit is still active; otherwise the
//              effective baja date.
// `setupBilledAt` = null until the setup fee has been invoiced; then the
//                   timestamp of the invoice that captured it. Prevents
//                   double-billing the setup line on subsequent periods.
// ---------------------------------------------------------------------------

model Unit {
  id            String    @id @default(uuid())
  serviceId     String    @map("service_id")
  externalId    String    @map("external_id")
  label         String?
  activeFrom    DateTime  @map("active_from")
  activeTo      DateTime? @map("active_to")
  setupBilledAt DateTime? @map("setup_billed_at")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  events  EventLog[]

  @@unique([serviceId, externalId])
  @@index([serviceId, activeTo])
  @@map("units")
}

// ---------------------------------------------------------------------------
// EventLog — append-only audit trail. Each event mutates the Unit table
// idempotently (by `transactionId`).
// ---------------------------------------------------------------------------

model EventLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  transactionId  String   @map("transaction_id")
  serviceId      String   @map("service_id")
  unitId         String?  @map("unit_id")
  unitExternalId String   @map("unit_external_id")
  unitLabel      String?  @map("unit_label")
  operationType  String   @map("operation_type") // "add" | "remove"
  kind           String? // free-text from the cliente ("monthly-ping", "setup", etc.)
  timestamp      DateTime
  properties     Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id])

  @@unique([organizationId, transactionId])
  @@index([serviceId, timestamp])
  @@map("event_log")
}

// ---------------------------------------------------------------------------
// Invoice (Factura).
// ---------------------------------------------------------------------------

model Invoice {
  id                                String    @id @default(uuid())
  organizationId                    String    @map("organization_id")
  customerId                        String    @map("customer_id")
  serviceId                         String?   @map("service_id")
  sequentialId                      Int       @map("sequential_id")
  number                            String? // folio CFDI (null hasta external-confirm)
  issuingDate                       DateTime  @map("issuing_date") @db.Date
  paymentDueDate                    DateTime  @map("payment_due_date") @db.Date
  netPaymentTerm                    Int       @default(0) @map("net_payment_term")
  status                            String    @default("calculated") // calculated | finalized | voided
  externalDispatchStatus            String    @default("pending") @map("external_dispatch_status")
  externalDispatchError             String?   @map("external_dispatch_error")
  paymentStatus                     String    @default("pending") @map("payment_status")
  currency                          String
  feesAmountCents                   Int       @default(0) @map("fees_amount_cents")
  taxesAmountCents                  Int       @default(0) @map("taxes_amount_cents")
  totalAmountCents                  Int       @default(0) @map("total_amount_cents")
  periodFrom                        DateTime? @map("period_from")
  periodTo                          DateTime? @map("period_to")
  metadata                          Json      @default("{}")
  unitsAnnex                        Json      @default("[]") @map("units_annex")
  idempotencyKey                    String?   @map("idempotency_key")
  externalInvoiceFolio              String?   @map("external_invoice_folio")
  externalInvoiceUuidCfdi           String?   @map("external_invoice_uuid_cfdi")
  externalInvoiceSystem             String?   @map("external_invoice_system")
  externalInvoiceNetsuiteInternalId String?   @map("external_invoice_netsuite_internal_id")
  externalInvoicePdfUrl             String?   @map("external_invoice_pdf_url")
  externalInvoiceXmlUrl             String?   @map("external_invoice_xml_url")
  externalInvoiceIssuedAt           DateTime? @map("external_invoice_issued_at")
  externalInvoiceConfirmedAt        DateTime? @map("external_invoice_confirmed_at")
  externalInvoiceDueDate            DateTime? @map("external_invoice_due_date") @db.Date
  netsuiteDispatchId                String?   @map("netsuite_dispatch_id")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  service      Service?     @relation(fields: [serviceId], references: [id])
  fees         Fee[]
  appliedTaxes AppliedTax[]
  creditNotes  CreditNote[]

  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Fee (Línea de factura).
//
// `kind`:
//   "monthly" — billed by service.monthlyUnitAmountCents × units (prorated).
//   "setup"   — one-off; one fee per unit being setup-billed for the first
//               time during this invoice.
//   "manual"  — free-text extra line (caller-provided unit_amount / units).
// ---------------------------------------------------------------------------

model Fee {
  id                String   @id @default(uuid())
  invoiceId         String   @map("invoice_id")
  serviceId         String?  @map("service_id")
  addOnId           String?  @map("add_on_id")
  kind              String // "monthly" | "setup" | "addon_per_unit_monthly" | "addon_flat_monthly"
  description       String?
  units             String // string decimal — 4 dígitos para monthly, "1.0000" para setup
  unitAmountCents   Int      @map("unit_amount_cents")
  preciseUnitAmount String   @map("precise_unit_amount") // "450.00"
  amountCents       Int      @map("amount_cents")
  taxesAmountCents  Int      @default(0) @map("taxes_amount_cents")
  taxesRate         Decimal  @default(0) @map("taxes_rate") @db.Decimal(10, 4)
  totalAmountCents  Int      @map("total_amount_cents")
  billedUnitsDetail Json     @default("[]") @map("billed_units_detail")
  paymentStatus     String   @default("pending") @map("payment_status")
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")

  invoice Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service?         @relation(fields: [serviceId], references: [id])
  addOn   AddOn?           @relation(fields: [addOnId], references: [id])
  cnItems CreditNoteItem[]

  @@index([invoiceId])
  @@map("fees")
}

model AppliedTax {
  id              String   @id @default(uuid())
  invoiceId       String   @map("invoice_id")
  taxId           String   @map("tax_id")
  taxName         String   @map("tax_name")
  taxCode         String   @map("tax_code")
  taxRate         Decimal  @map("tax_rate") @db.Decimal(10, 4)
  taxDescription  String?  @map("tax_description")
  amountCents     Int      @map("amount_cents")
  amountCurrency  String   @map("amount_currency")
  feesAmountCents Int      @map("fees_amount_cents")
  createdAt       DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tax     Tax     @relation(fields: [taxId], references: [id])

  @@map("applied_taxes")
}

// ---------------------------------------------------------------------------
// Credit note (Nota de crédito).
// ---------------------------------------------------------------------------

model CreditNote {
  id                                String    @id @default(uuid())
  organizationId                    String    @map("organization_id")
  customerId                        String    @map("customer_id")
  invoiceId                         String    @map("invoice_id")
  sequentialId                      Int       @map("sequential_id")
  number                            String?
  status                            String    @default("calculated")
  externalDispatchStatus            String    @default("pending") @map("external_dispatch_status")
  externalDispatchError             String?   @map("external_dispatch_error")
  creditStatus                      String    @default("available") @map("credit_status")
  refundStatus                      String?   @map("refund_status")
  reason                            String
  description                       String?
  currency                          String
  totalAmountCents                  Int       @map("total_amount_cents")
  taxesAmountCents                  Int       @map("taxes_amount_cents")
  subTotalExcludingTaxesAmountCents Int       @map("sub_total_excluding_taxes_amount_cents")
  balanceAmountCents                Int       @map("balance_amount_cents")
  creditAmountCents                 Int       @map("credit_amount_cents")
  refundAmountCents                 Int       @default(0) @map("refund_amount_cents")
  taxesRate                         Decimal   @default(0) @map("taxes_rate") @db.Decimal(10, 4)
  fileUrl                           String?   @map("file_url")
  issuingDate                       DateTime  @map("issuing_date") @db.Date
  idempotencyMarker                 String?   @map("idempotency_marker")
  externalCreditNoteFolio           String?   @map("external_credit_note_folio")
  externalCreditNoteUuidCfdi        String?   @map("external_credit_note_uuid_cfdi")
  externalCreditNoteSystem          String?   @map("external_credit_note_system")
  externalCreditNoteNetsuiteId      String?   @map("external_credit_note_netsuite_id")
  externalCreditNotePdfUrl          String?   @map("external_credit_note_pdf_url")
  externalCreditNoteXmlUrl          String?   @map("external_credit_note_xml_url")
  externalCreditNoteIssuedAt        DateTime? @map("external_credit_note_issued_at")
  externalCreditNoteConfirmedAt     DateTime? @map("external_credit_note_confirmed_at")
  netsuiteDispatchId                String?   @map("netsuite_dispatch_id")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer               @relation(fields: [customerId], references: [id])
  invoice      Invoice                @relation(fields: [invoiceId], references: [id])
  items        CreditNoteItem[]
  appliedTaxes CreditNoteAppliedTax[]

  @@map("credit_notes")
}

model CreditNoteItem {
  id             String   @id @default(uuid())
  creditNoteId   String   @map("credit_note_id")
  feeId          String   @map("fee_id")
  amountCents    Int      @map("amount_cents")
  amountCurrency String   @map("amount_currency")
  createdAt      DateTime @default(now()) @map("created_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  fee        Fee        @relation(fields: [feeId], references: [id])

  @@map("credit_note_items")
}

model CreditNoteAppliedTax {
  id              String   @id @default(uuid())
  creditNoteId    String   @map("credit_note_id")
  taxId           String   @map("tax_id")
  taxName         String   @map("tax_name")
  taxCode         String   @map("tax_code")
  taxRate         Decimal  @map("tax_rate") @db.Decimal(10, 4)
  taxDescription  String?  @map("tax_description")
  amountCents     Int      @map("amount_cents")
  amountCurrency  String   @map("amount_currency")
  baseAmountCents Int      @map("base_amount_cents")
  createdAt       DateTime @default(now()) @map("created_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  tax        Tax        @relation(fields: [taxId], references: [id])

  @@map("credit_note_applied_taxes")
}

// ---------------------------------------------------------------------------
// Idempotency store.
// ---------------------------------------------------------------------------

model IdempotencyRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  path           String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, path, key])
  @@map("idempotency_records")
}
