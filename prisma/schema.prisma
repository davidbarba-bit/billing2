// mini-Lago Prisma schema — v3 redesign.
//
// Key change vs v2: invoices are now per Customer (not per Service). A
// customer's invoice aggregates fees from ALL of its active services
// (monthly + setup + service-level per-unit add-ons) plus its own flat
// customer-level add-ons. The billing cycle (calendar / anniversary) lives
// on the Customer, not the Service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization (tenant).
// ---------------------------------------------------------------------------

model Organization {
  id                     String   @id @default(uuid())
  slug                   String   @unique
  name                   String
  timezone               String   @default("UTC")
  apiKey                 String   @unique @map("api_key")
  netsuiteAccountId      String?  @map("netsuite_account_id")
  netsuiteConsumerKey    String?  @map("netsuite_consumer_key")
  netsuiteConsumerSecret String?  @map("netsuite_consumer_secret")
  netsuiteTokenKey       String?  @map("netsuite_token_key")
  netsuiteTokenSecret    String?  @map("netsuite_token_secret")
  netsuiteRestBase       String?  @map("netsuite_rest_base")
  netsuiteCallbackSecret String?  @map("netsuite_callback_secret")
  customerCounter        Int      @default(0) @map("customer_counter")
  invoiceCounter         Int      @default(0) @map("invoice_counter")
  creditNoteCounter      Int      @default(0) @map("credit_note_counter")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  customers       Customer[]
  services        Service[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  events          EventLog[]
  idempotencyKeys IdempotencyRecord[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Customer — owns the billing cycle.
// ---------------------------------------------------------------------------

model Customer {
  id                            String    @id @default(uuid())
  organizationId                String    @map("organization_id")
  externalId                    String    @map("external_id")
  sequentialId                  Int       @map("sequential_id")
  slug                          String
  name                          String
  email                         String?
  phone                         String?
  taxIdentificationNumber       String?   @map("tax_identification_number")
  addressLine1                  String?   @map("address_line1")
  addressLine2                  String?   @map("address_line2")
  state                         String?
  zipcode                       String?
  city                          String?
  country                       String?
  currency                      String
  timezone                      String?
  // v4: billing cycle anclado a día N + intervalo configurable. Eliminamos
  // `billing_time` (calendar/anniversary) — siempre es calendario con día N.
  billingPeriodMonths           Int       @default(1) @map("billing_period_months") // 1 | 3 | 6 | 12
  billingAnchorDay              Int       @default(1) @map("billing_anchor_day") // 1..28
  // Cómo cobrar units de servicios one-off cuando entran (primer ping):
  //   "immediate"   → 1 invoice por ping, emitida al instante del POST /events
  //   "next_cycle"  → unit pendiente hasta el cierre del ciclo, sale en la cycle invoice del customer
  nonrecurringTrigger           String    @default("next_cycle") @map("nonrecurring_trigger")
  subscriptionAt                DateTime  @map("subscription_at")
  startedAt                     DateTime? @map("started_at")
  terminatedAt                  DateTime? @map("terminated_at")
  currentBillingPeriodStartedAt DateTime? @map("current_billing_period_started_at")
  currentBillingPeriodEndingAt  DateTime? @map("current_billing_period_ending_at")
  status                        String    @default("active") // pending | active | terminated
  metadata                      Json      @default("{}")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]
  addOns       CustomerAddOn[]
  invoices     Invoice[]
  creditNotes  CreditNote[]

  @@unique([organizationId, externalId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Tax handling — desde v5 mini-Lago NO calcula impuestos. Las invoices se
// envían a NetSuite con montos netos por partida; NetSuite aplica los
// impuestos que tenga configurados para cada cliente (incluyendo IVA MX
// 16%, IEPS, retenciones, etc.) y emite el CFDI con esas particularidades.
// El RFC del cliente (`tax_identification_number` en Customer) sigue siendo
// metadata fiscal que se le pasa a NetSuite.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Service — owns units + per-unit pricing. Does NOT own billing cycle (the
// customer does, since one invoice aggregates many services).
// ---------------------------------------------------------------------------

model Service {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  customerId             String    @map("customer_id")
  code                   String
  name                   String
  description            String?
  currency               String
  // v4: pricing_model decide cómo se cobra.
  //   "recurring" → renta per_unit (monthlyUnitAmountCents) cada periodo del customer
  //                 + setup opcional (setupUnitAmountCents) una vez por unit.
  //   "one_off"   → cargo único per_unit (monthlyUnitAmountCents) cuando la unit aparece.
  //                 setupUnitAmountCents debe ser 0 (no aplica en one_off).
  pricingModel           String    @default("recurring") @map("pricing_model")
  monthlyUnitAmountCents Int       @default(0) @map("monthly_unit_amount_cents")
  setupUnitAmountCents   Int       @default(0) @map("setup_unit_amount_cents")
  // Default de meses prepagados por unit (solo aplica a pricing_model=one_off).
  // Puede ser sobreescrito a nivel Unit (Unit.prepaidMonths). Si ambos son
  // null al momento de facturar, se aborta el cobro con un error.
  prepaidMonthsDefault   Int?      @map("prepaid_months_default")
  status                 String    @default("active") // active | terminated
  terminatedAt           DateTime? @map("terminated_at")
  metadata               Json      @default("{}")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  units        Unit[]
  addOns       ServiceAddOn[]
  events       EventLog[]
  fees         Fee[]

  @@unique([organizationId, code])
  @@index([customerId])
  @@map("services")
}

// ---------------------------------------------------------------------------
// ServiceAddOn — per-unit recurring modifier attached to a Service.
// Ej: "+$50/u por historial 12 meses".
// ---------------------------------------------------------------------------

model ServiceAddOn {
  id          String    @id @default(uuid())
  serviceId   String    @map("service_id")
  code        String
  name        String
  description String?
  amountCents Int       @map("amount_cents")
  activeFrom  DateTime  @map("active_from")
  activeTo    DateTime? @map("active_to")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  fees    Fee[]

  @@unique([serviceId, code])
  @@index([serviceId, activeTo])
  @@map("service_add_ons")
}

// ---------------------------------------------------------------------------
// CustomerAddOn — flat recurring modifier attached to a Customer.
// Ej: "+$1000/mes por 10 reglas de evento" (independiente de services o
// unidades).
// ---------------------------------------------------------------------------

model CustomerAddOn {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  code        String
  name        String
  description String?
  amountCents Int       @map("amount_cents")
  activeFrom  DateTime  @map("active_from")
  activeTo    DateTime? @map("active_to")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fees     Fee[]

  @@unique([customerId, code])
  @@index([customerId, activeTo])
  @@map("customer_add_ons")
}

// ---------------------------------------------------------------------------
// Unit — materialised, no event-replay.
// ---------------------------------------------------------------------------

model Unit {
  id            String    @id @default(uuid())
  serviceId     String    @map("service_id")
  externalId    String    @map("external_id")
  label         String?
  activeFrom    DateTime  @map("active_from")
  activeTo      DateTime? @map("active_to")
  // Gates de cobro one-off por unit:
  //   setupBilledAt   → para services recurring + setup_unit_amount_cents > 0
  //   oneoffBilledAt  → para services one_off (la unit no vuelve a aparecer en facturas)
  setupBilledAt DateTime? @map("setup_billed_at")
  oneoffBilledAt DateTime? @map("oneoff_billed_at")
  // Meses prepagados para esta unit (override del default del Service). Solo
  // aplica si el Service es one_off. Cuando la unit se factura por primera vez,
  // se cobra setup + N × monthly y la unit queda marcada con oneoffBilledAt.
  prepaidMonths Int?      @map("prepaid_months")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  events  EventLog[]

  @@unique([serviceId, externalId])
  @@index([serviceId, activeTo])
  @@map("units")
}

// ---------------------------------------------------------------------------
// EventLog — append-only audit.
// ---------------------------------------------------------------------------

model EventLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  transactionId  String   @map("transaction_id")
  serviceId      String   @map("service_id")
  unitId         String?  @map("unit_id")
  unitExternalId String   @map("unit_external_id")
  unitLabel      String?  @map("unit_label")
  operationType  String   @map("operation_type") // add | remove
  kind           String?
  timestamp      DateTime
  properties     Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id])

  @@unique([organizationId, transactionId])
  @@index([serviceId, timestamp])
  @@map("event_log")
}

// ---------------------------------------------------------------------------
// Invoice — per Customer per Period.
//
// Contains fees from all the customer's active services + customer-level
// add-ons. No serviceId at the invoice level (fees reference services and
// add-ons explicitly).
// ---------------------------------------------------------------------------

model Invoice {
  id                                String    @id @default(uuid())
  organizationId                    String    @map("organization_id")
  customerId                        String    @map("customer_id")
  sequentialId                      Int       @map("sequential_id")
  number                            String?
  issuingDate                       DateTime  @map("issuing_date") @db.Date
  paymentDueDate                    DateTime  @map("payment_due_date") @db.Date
  netPaymentTerm                    Int       @default(0) @map("net_payment_term")
  status                            String    @default("calculated") // calculated | finalized | voided
  externalDispatchStatus            String    @default("pending") @map("external_dispatch_status")
  externalDispatchError             String?   @map("external_dispatch_error")
  paymentStatus                     String    @default("pending") @map("payment_status")
  currency                          String
  // Total neto sin impuestos. NetSuite calcula y agrega los taxes que
  // correspondan al cliente cuando genera el CFDI.
  feesAmountCents                   Int       @default(0) @map("fees_amount_cents")
  periodFrom                        DateTime? @map("period_from")
  periodTo                          DateTime? @map("period_to")
  metadata                          Json      @default("{}")
  unitsAnnex                        Json      @default("[]") @map("units_annex")
  idempotencyKey                    String?   @map("idempotency_key")
  externalInvoiceFolio              String?   @map("external_invoice_folio")
  externalInvoiceUuidCfdi           String?   @map("external_invoice_uuid_cfdi")
  externalInvoiceSystem             String?   @map("external_invoice_system")
  externalInvoiceNetsuiteInternalId String?   @map("external_invoice_netsuite_internal_id")
  externalInvoicePdfUrl             String?   @map("external_invoice_pdf_url")
  externalInvoiceXmlUrl             String?   @map("external_invoice_xml_url")
  externalInvoiceIssuedAt           DateTime? @map("external_invoice_issued_at")
  externalInvoiceConfirmedAt        DateTime? @map("external_invoice_confirmed_at")
  externalInvoiceDueDate            DateTime? @map("external_invoice_due_date") @db.Date
  netsuiteDispatchId                String?   @map("netsuite_dispatch_id")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  fees         Fee[]
  creditNotes  CreditNote[]

  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Fee — line item on an invoice.
//
// `kind`:
//   "monthly"        per_unit base monthly fee (1 per service per invoice)
//   "setup"          per_unit one-off setup fee (1 per service per invoice)
//   "service_addon"  per_unit recurring add-on on a service
//   "customer_addon" flat recurring add-on on the customer
// ---------------------------------------------------------------------------

model Fee {
  id                String   @id @default(uuid())
  invoiceId         String   @map("invoice_id")
  serviceId         String?  @map("service_id")
  serviceAddOnId    String?  @map("service_add_on_id")
  customerAddOnId   String?  @map("customer_add_on_id")
  kind              String
  description       String?
  units             String
  unitAmountCents   Int      @map("unit_amount_cents")
  preciseUnitAmount String   @map("precise_unit_amount")
  // Monto neto sin impuestos. NetSuite calcula los taxes para el CFDI.
  amountCents       Int      @map("amount_cents")
  billedUnitsDetail Json     @default("[]") @map("billed_units_detail")
  paymentStatus     String   @default("pending") @map("payment_status")
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")

  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service         Service?         @relation(fields: [serviceId], references: [id])
  serviceAddOn    ServiceAddOn?    @relation(fields: [serviceAddOnId], references: [id])
  customerAddOn   CustomerAddOn?   @relation(fields: [customerAddOnId], references: [id])
  cnItems         CreditNoteItem[]

  @@index([invoiceId])
  @@map("fees")
}

// ---------------------------------------------------------------------------
// Credit note.
// ---------------------------------------------------------------------------

model CreditNote {
  id                                String    @id @default(uuid())
  organizationId                    String    @map("organization_id")
  customerId                        String    @map("customer_id")
  invoiceId                         String    @map("invoice_id")
  sequentialId                      Int       @map("sequential_id")
  number                            String?
  status                            String    @default("calculated")
  externalDispatchStatus            String    @default("pending") @map("external_dispatch_status")
  externalDispatchError             String?   @map("external_dispatch_error")
  creditStatus                      String    @default("available") @map("credit_status")
  refundStatus                      String?   @map("refund_status")
  reason                            String
  description                       String?
  currency                          String
  // Monto neto sin impuestos (NetSuite calcula los taxes para el CFDI).
  totalAmountCents                  Int       @map("total_amount_cents")
  balanceAmountCents                Int       @map("balance_amount_cents")
  creditAmountCents                 Int       @map("credit_amount_cents")
  refundAmountCents                 Int       @default(0) @map("refund_amount_cents")
  fileUrl                           String?   @map("file_url")
  issuingDate                       DateTime  @map("issuing_date") @db.Date
  idempotencyMarker                 String?   @map("idempotency_marker")
  externalCreditNoteFolio           String?   @map("external_credit_note_folio")
  externalCreditNoteUuidCfdi        String?   @map("external_credit_note_uuid_cfdi")
  externalCreditNoteSystem          String?   @map("external_credit_note_system")
  externalCreditNoteNetsuiteId      String?   @map("external_credit_note_netsuite_id")
  externalCreditNotePdfUrl          String?   @map("external_credit_note_pdf_url")
  externalCreditNoteXmlUrl          String?   @map("external_credit_note_xml_url")
  externalCreditNoteIssuedAt        DateTime? @map("external_credit_note_issued_at")
  externalCreditNoteConfirmedAt     DateTime? @map("external_credit_note_confirmed_at")
  netsuiteDispatchId                String?   @map("netsuite_dispatch_id")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id])
  invoice      Invoice          @relation(fields: [invoiceId], references: [id])
  items        CreditNoteItem[]

  @@map("credit_notes")
}

model CreditNoteItem {
  id             String   @id @default(uuid())
  creditNoteId   String   @map("credit_note_id")
  feeId          String   @map("fee_id")
  amountCents    Int      @map("amount_cents")
  amountCurrency String   @map("amount_currency")
  createdAt      DateTime @default(now()) @map("created_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  fee        Fee        @relation(fields: [feeId], references: [id])

  @@map("credit_note_items")
}

// ---------------------------------------------------------------------------
// Idempotency.
// ---------------------------------------------------------------------------

model IdempotencyRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  path           String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, path, key])
  @@map("idempotency_records")
}
