{
  "openapi": "3.1.0",
  "info": {
    "title": "mini-Lago API (Numaris-native)",
    "version": "2.0.0",
    "description": "Motor de facturación domain-specific para Numaris. Entidades: Customer, Tax, Service (colapsa Plan+Sub+Charge+BM+AddOn), Unit (materializada), EventLog (audit), Invoice, CreditNote.\n\n**Auth**: Bearer en todos los `/api/v1/*` excepto health/openapi/discovery. Callbacks NetSuite usan HMAC-SHA256 (`X-NetSuite-Signature`).\n\n**Idempotency** en POST /invoices y POST /credit_notes vía header `Idempotency-Key` + `metadata.idempotency_key`."
  },
  "servers": [
    { "url": "https://billing2-production.up.railway.app", "description": "Railway production" },
    { "url": "http://localhost:3000", "description": "Local dev" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer" },
      "NetSuiteSignature": { "type": "apiKey", "in": "header", "name": "X-NetSuite-Signature" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "error": { "type": "string" },
          "code": { "type": "string" },
          "error_details": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "current_page": { "type": "integer" },
          "next_page": { "type": ["integer", "null"] },
          "prev_page": { "type": ["integer", "null"] },
          "total_pages": { "type": "integer" },
          "total_count": { "type": "integer" }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "external_id": { "type": "string" },
          "sequential_id": { "type": "integer" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": ["string", "null"] },
          "phone": { "type": ["string", "null"] },
          "tax_identification_number": { "type": ["string", "null"] },
          "address_line1": { "type": ["string", "null"] },
          "city": { "type": ["string", "null"] },
          "country": { "type": ["string", "null"] },
          "currency": { "type": "string" },
          "timezone": { "type": ["string", "null"] },
          "applicable_timezone": { "type": "string" },
          "metadata": { "type": "object" },
          "taxes": { "type": "array", "items": { "$ref": "#/components/schemas/Tax" } }
        }
      },
      "CustomerWriteable": {
        "type": "object",
        "required": ["external_id", "name", "currency"],
        "properties": {
          "external_id": { "type": "string" },
          "name": { "type": "string" },
          "currency": { "type": "string", "example": "MXN" },
          "country": { "type": "string", "example": "MX" },
          "timezone": { "type": "string", "example": "America/Mexico_City" },
          "tax_identification_number": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "address_line1": { "type": "string" },
          "city": { "type": "string" },
          "metadata": { "type": "object" },
          "tax_codes": { "type": "array", "items": { "type": "string" }, "description": "Reemplazo total (D2)." }
        }
      },
      "Tax": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "rate": { "type": "number", "example": 16.0 }
        }
      },
      "TaxWriteable": {
        "type": "object",
        "required": ["code", "name", "rate"],
        "properties": {
          "code": { "type": "string", "example": "iva-mx-16" },
          "name": { "type": "string", "example": "IVA México" },
          "description": { "type": "string" },
          "rate": { "oneOf": [{ "type": "string" }, { "type": "number" }], "example": "16" }
        }
      },
      "Service": {
        "type": "object",
        "description": "Numaris-native: 1 customer ↔ N services. Cada service tiene su propia tarifa mensual por unidad + setup one-off.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "customer_id": { "type": "string", "format": "uuid" },
          "currency": { "type": "string" },
          "monthly_unit_amount_cents": { "type": "integer" },
          "setup_unit_amount_cents": { "type": "integer" },
          "status": { "type": "string", "enum": ["pending", "active", "terminated"] },
          "billing_time": { "type": "string", "enum": ["calendar", "anniversary"] },
          "subscription_at": { "type": "string", "format": "date-time" },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "current_billing_period_started_at": { "type": ["string", "null"], "format": "date-time" },
          "current_billing_period_ending_at": { "type": ["string", "null"], "format": "date-time" },
          "taxes": { "type": "array", "items": { "$ref": "#/components/schemas/Tax" }, "description": "Si vacío, hereda taxes del customer." },
          "metadata": { "type": "object" }
        }
      },
      "ServiceWriteable": {
        "type": "object",
        "required": ["code", "name", "customer_external_id"],
        "properties": {
          "code": { "type": "string", "example": "combustible-foo" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "customer_external_id": { "type": "string" },
          "currency": { "type": "string", "description": "Default: customer.currency." },
          "monthly_unit_amount_cents": { "type": "integer", "minimum": 0, "example": 45000 },
          "setup_unit_amount_cents": { "type": "integer", "minimum": 0, "example": 120000 },
          "billing_time": { "type": "string", "enum": ["calendar", "anniversary"], "default": "calendar" },
          "subscription_at": { "type": "string", "format": "date-time", "description": "Si es futuro → status=pending." },
          "tax_codes": { "type": "array", "items": { "type": "string" }, "description": "Si vacío, usa los del customer." },
          "metadata": { "type": "object" }
        }
      },
      "Unit": {
        "type": "object",
        "description": "Unidad facturable materializada (no derivada de eventos).",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "service_id": { "type": "string", "format": "uuid" },
          "external_id": { "type": "string" },
          "label": { "type": ["string", "null"] },
          "active_from": { "type": "string", "format": "date-time" },
          "active_to": { "type": ["string", "null"], "format": "date-time", "description": "null = activa." },
          "setup_billed_at": { "type": ["string", "null"], "format": "date-time", "description": "null = setup pendiente; se cobrará en la próxima factura." },
          "status": { "type": "string", "enum": ["active", "terminated"] },
          "metadata": { "type": "object" }
        }
      },
      "UnitWriteable": {
        "type": "object",
        "required": ["service_code", "external_id"],
        "properties": {
          "service_code": { "type": "string" },
          "external_id": { "type": "string" },
          "label": { "type": "string" },
          "active_from": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object" }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "transaction_id": { "type": "string" },
          "service_id": { "type": "string", "format": "uuid" },
          "unit_id": { "type": ["string", "null"], "format": "uuid" },
          "unit_external_id": { "type": "string" },
          "unit_label": { "type": ["string", "null"] },
          "operation_type": { "type": "string", "enum": ["add", "remove"] },
          "kind": { "type": ["string", "null"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "properties": { "type": "object" }
        }
      },
      "EventWriteable": {
        "type": "object",
        "required": ["transaction_id", "service_code", "operation_type", "unit_external_id", "timestamp"],
        "properties": {
          "transaction_id": { "type": "string" },
          "service_code": { "type": "string" },
          "operation_type": { "type": "string", "enum": ["add", "remove"] },
          "unit_external_id": { "type": "string" },
          "unit_label": { "type": "string" },
          "timestamp": { "type": "integer", "description": "Unix epoch en SEGUNDOS." },
          "kind": { "type": "string" },
          "properties": { "type": "object" }
        }
      },
      "InvoiceWriteable": {
        "type": "object",
        "required": ["service_code"],
        "properties": {
          "service_code": { "type": "string" },
          "period_from": { "type": "string", "format": "date-time", "description": "Si se omite, usa el periodo actual del service." },
          "period_to": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object", "properties": { "idempotency_key": { "type": "string" } } }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sequential_id": { "type": "integer" },
          "number": { "type": ["string", "null"], "description": "Folio fiscal NetSuite." },
          "customer_id": { "type": "string", "format": "uuid" },
          "service_id": { "type": ["string", "null"], "format": "uuid" },
          "status": { "type": "string", "enum": ["calculated", "finalized", "voided"] },
          "external_dispatch_status": { "type": "string", "enum": ["pending", "dispatched", "confirmed", "failed"] },
          "currency": { "type": "string" },
          "fees_amount_cents": { "type": "integer" },
          "taxes_amount_cents": { "type": "integer" },
          "total_amount_cents": { "type": "integer" },
          "period_from": { "type": ["string", "null"], "format": "date-time" },
          "period_to": { "type": ["string", "null"], "format": "date-time" },
          "fees": { "type": "array", "items": { "$ref": "#/components/schemas/Fee" } },
          "units_annex": { "type": "array", "items": { "$ref": "#/components/schemas/UnitsAnnexEntry" } },
          "applied_taxes": { "type": "array", "items": { "type": "object" } },
          "external_invoice": { "type": ["object", "null"] }
        }
      },
      "Fee": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "type": "string", "enum": ["monthly", "setup"] },
          "description": { "type": "string" },
          "units": { "type": "string", "description": "String decimal 4 dígitos." },
          "unit_amount_cents": { "type": "integer" },
          "amount_cents": { "type": "integer" },
          "taxes_amount_cents": { "type": "integer" },
          "total_amount_cents": { "type": "integer" },
          "billed_units_detail": { "type": "array", "items": { "$ref": "#/components/schemas/BilledUnitDetail" } }
        }
      },
      "BilledUnitDetail": {
        "type": "object",
        "properties": {
          "external_id": { "type": "string" },
          "label": { "type": ["string", "null"] },
          "active_from": { "type": "string", "format": "date-time" },
          "active_to": { "type": ["string", "null"], "format": "date-time" },
          "billed_fraction": { "type": "string", "description": "String decimal 4 dígitos (eg. 0.6129)." },
          "amount_cents": { "type": "integer" }
        }
      },
      "UnitsAnnexEntry": {
        "type": "object",
        "properties": {
          "external_id": { "type": "string" },
          "label": { "type": ["string", "null"] },
          "fees": { "type": "array", "items": { "type": "object", "properties": { "kind": { "type": "string" }, "amount_cents": { "type": "integer" } } } }
        }
      },
      "CreditNoteWriteable": {
        "type": "object",
        "required": ["invoice_id", "reason", "items"],
        "properties": {
          "invoice_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "enum": ["duplicated_charge", "product_unsatisfactory", "order_change", "order_cancellation", "fraudulent_charge", "other"] },
          "description": { "type": "string" },
          "credit_amount_cents": { "type": "integer" },
          "refund_amount_cents": { "type": "integer" },
          "items": { "type": "array", "items": { "type": "object", "required": ["fee_id", "amount_cents"], "properties": { "fee_id": { "type": "string", "format": "uuid" }, "amount_cents": { "type": "integer", "minimum": 1 } } } }
        }
      },
      "CreditNote": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sequential_id": { "type": "integer" },
          "number": { "type": ["string", "null"] },
          "invoice_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "external_dispatch_status": { "type": "string" },
          "reason": { "type": "string" },
          "description": { "type": "string" },
          "total_amount_cents": { "type": "integer" },
          "taxes_amount_cents": { "type": "integer" }
        }
      },
      "ExternalConfirmInvoice": {
        "type": "object",
        "required": ["external_invoice"],
        "properties": {
          "external_invoice": {
            "type": "object",
            "required": ["folio"],
            "properties": {
              "folio": { "type": "string" },
              "uuid_cfdi": { "type": "string" },
              "system": { "type": "string", "default": "netsuite" },
              "netsuite_internal_id": { "type": "string" },
              "pdf_url": { "type": "string", "format": "uri" },
              "xml_url": { "type": "string", "format": "uri" },
              "issued_at": { "type": "string", "format": "date-time" },
              "due_date": { "type": "string", "format": "date" }
            }
          }
        }
      },
      "ExternalConfirmCreditNote": {
        "type": "object",
        "required": ["external_credit_note"],
        "properties": {
          "external_credit_note": {
            "type": "object",
            "required": ["folio"],
            "properties": {
              "folio": { "type": "string" },
              "uuid_cfdi": { "type": "string" },
              "system": { "type": "string", "default": "netsuite" },
              "netsuite_internal_id": { "type": "string" },
              "issued_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  },
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/health": { "get": { "summary": "Health check", "security": [], "tags": ["meta"], "responses": { "200": { "description": "OK" } } } },
    "/openapi.json": { "get": { "summary": "OpenAPI 3.1 spec", "security": [], "tags": ["meta"], "responses": { "200": { "description": "JSON" } } } },
    "/api/v1": { "get": { "summary": "Endpoint discovery (no auth)", "security": [], "tags": ["meta"], "responses": { "200": { "description": "Lista plana de endpoints" } } } },

    "/api/v1/customers": {
      "post": {
        "summary": "Create / upsert customer por external_id (D1)",
        "tags": ["customers"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "customer": { "$ref": "#/components/schemas/CustomerWriteable" } } } } } },
        "responses": { "200": { "description": "Customer", "content": { "application/json": { "schema": { "type": "object", "properties": { "customer": { "$ref": "#/components/schemas/Customer" } } } } } } }
      },
      "get": {
        "summary": "List customers (paginado)",
        "tags": ["customers"],
        "parameters": [
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 100 } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": { "200": { "description": "Lista" } }
      }
    },
    "/api/v1/customers/{externalId}": {
      "get": { "summary": "Read customer", "tags": ["customers"], "parameters": [{ "name": "externalId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Customer" }, "404": { "description": "customer_not_found" } } },
      "delete": { "summary": "Delete customer (409 si tiene services activos)", "tags": ["customers"], "parameters": [{ "name": "externalId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" }, "409": { "description": "customer_has_active_services" } } }
    },

    "/api/v1/taxes": {
      "post": { "summary": "Create tax", "tags": ["taxes"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "tax": { "$ref": "#/components/schemas/TaxWriteable" } } } } } }, "responses": { "200": { "description": "Tax" } } },
      "get": { "summary": "List taxes", "tags": ["taxes"], "responses": { "200": { "description": "Lista" } } }
    },
    "/api/v1/taxes/{code}": {
      "get": { "summary": "Read tax", "tags": ["taxes"], "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Tax" } } }
    },

    "/api/v1/services": {
      "post": {
        "summary": "Create service (colapsa Plan+Sub+Charge+BM+AddOn)",
        "tags": ["services"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "service": { "$ref": "#/components/schemas/ServiceWriteable" } } } } } },
        "responses": { "200": { "description": "Service", "content": { "application/json": { "schema": { "type": "object", "properties": { "service": { "$ref": "#/components/schemas/Service" } } } } } } }
      },
      "get": {
        "summary": "List services",
        "tags": ["services"],
        "parameters": [
          { "name": "customer_external_id", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "active", "terminated"] } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 100 } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": { "200": { "description": "Lista" } }
      }
    },
    "/api/v1/services/{code}": {
      "get": { "summary": "Read service", "tags": ["services"], "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Service" } } },
      "delete": { "summary": "Delete service (409 si tiene invoices — usa terminate en su lugar)", "tags": ["services"], "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK" }, "409": { "description": "service_has_invoices" } } }
    },
    "/api/v1/services/{code}/terminate": {
      "post": { "summary": "Terminate service + todas sus units activas", "tags": ["services"], "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Service terminated" } } }
    },

    "/api/v1/units": {
      "post": { "summary": "Create unit (alternativa a POST /events con operation_type=add)", "tags": ["units"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "unit": { "$ref": "#/components/schemas/UnitWriteable" } } } } } }, "responses": { "200": { "description": "Unit" } } },
      "get": {
        "summary": "List units",
        "tags": ["units"],
        "parameters": [
          { "name": "service_code", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "terminated"] } }
        ],
        "responses": { "200": { "description": "Lista" } }
      }
    },
    "/api/v1/units/{id}": {
      "get": { "summary": "Read unit", "tags": ["units"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Unit" } } },
      "patch": { "summary": "Update unit (label, active_to, metadata)", "tags": ["units"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Unit" } } }
    },

    "/api/v1/events": {
      "post": {
        "summary": "POST event (add o remove unit). Materializa la unidad en la tabla `units` como side effect.",
        "tags": ["events"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "event": { "$ref": "#/components/schemas/EventWriteable" } } } } } },
        "responses": { "200": { "description": "Event", "content": { "application/json": { "schema": { "type": "object", "properties": { "event": { "$ref": "#/components/schemas/Event" } } } } } } }
      },
      "get": {
        "summary": "Event log (audit trail)",
        "tags": ["events"],
        "parameters": [
          { "name": "service_code", "in": "query", "schema": { "type": "string" } },
          { "name": "unit_external_id", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Lista" } }
      }
    },

    "/api/v1/invoices": {
      "post": {
        "summary": "Calcular invoice del periodo actual del service",
        "tags": ["invoices"],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "schema": { "type": "string" }, "description": "Debe coincidir con metadata.idempotency_key." }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "invoice": { "$ref": "#/components/schemas/InvoiceWriteable" } } } } } },
        "responses": { "200": { "description": "Invoice", "content": { "application/json": { "schema": { "type": "object", "properties": { "invoice": { "$ref": "#/components/schemas/Invoice" } } } } } } }
      },
      "get": {
        "summary": "List invoices",
        "tags": ["invoices"],
        "parameters": [
          { "name": "customer_external_id", "in": "query", "schema": { "type": "string" } },
          { "name": "service_code", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Lista" } }
      }
    },
    "/api/v1/invoices/{id}": {
      "get": { "summary": "Read invoice", "tags": ["invoices"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Invoice" } } }
    },
    "/api/v1/invoices/{id}/void": {
      "post": { "summary": "Void invoice", "tags": ["invoices"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Invoice voided" } } }
    },
    "/api/v1/invoices/{id}/external-confirm": {
      "post": {
        "summary": "Callback NetSuite (HMAC-firmado)",
        "tags": ["external-confirm"],
        "security": [{ "NetSuiteSignature": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalConfirmInvoice" } } } },
        "responses": { "200": { "description": "Invoice finalized" }, "401": { "description": "invalid_signature" }, "403": { "description": "secret_not_configured" }, "409": { "description": "conflict_folio_changed" } }
      }
    },

    "/api/v1/credit_notes": {
      "post": {
        "summary": "Create credit note (solo sobre invoice finalized+confirmed)",
        "tags": ["credit_notes"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "credit_note": { "$ref": "#/components/schemas/CreditNoteWriteable" } } } } } },
        "responses": { "200": { "description": "CN" }, "422": { "description": "invoice_not_confirmed" } }
      },
      "get": { "summary": "List credit notes", "tags": ["credit_notes"], "parameters": [{ "name": "customer_external_id", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Lista" } } }
    },
    "/api/v1/credit_notes/{id}": {
      "get": { "summary": "Read credit note", "tags": ["credit_notes"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "CN" } } }
    },
    "/api/v1/credit_notes/{id}/external-confirm": {
      "post": {
        "summary": "Callback NetSuite para CN (HMAC-firmado)",
        "tags": ["external-confirm"],
        "security": [{ "NetSuiteSignature": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalConfirmCreditNote" } } } },
        "responses": { "200": { "description": "CN finalized" } }
      }
    },

    "/api/v1/admin/reset": {
      "post": {
        "summary": "Hard reset destructivo (wipea data, preserva org)",
        "tags": ["admin"],
        "parameters": [{ "name": "X-Admin-Reset-Token", "in": "header", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["confirm"], "properties": { "confirm": { "type": "string", "description": "Debe = organization.slug." } } } } } },
        "responses": { "200": { "description": "Reset OK" }, "403": { "description": "admin_reset_disabled | invalid_reset_token" } }
      }
    }
  }
}
