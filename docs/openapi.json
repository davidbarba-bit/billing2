{
  "openapi": "3.1.0",
  "info": {
    "title": "mini-Lago API",
    "version": "1.0.0",
    "description": "Motor de cálculo de facturación por uso real + dispatcher hacia NetSuite. Contrato derivado de `mini-lago-spec.md` (21 endpoints baseline) extendido con list/read endpoints estilo Lago para que clientes que hablan el wire de Lago puedan migrar sin cambios mayores.\n\n**Auth**: todos los endpoints `/api/v1/*` requieren `Authorization: Bearer <API_KEY>`. El callback NetSuite (`/external-confirm`) usa `X-NetSuite-Signature: sha256=<hex>` con HMAC-SHA256 timing-safe sobre el body raw.\n\n**Idempotencia**: `POST /api/v1/invoices` y `POST /api/v1/credit_notes` aceptan `Idempotency-Key` header + `metadata.idempotency_key` (deben coincidir o se devuelve 422).",
    "contact": {
      "name": "mini-Lago",
      "url": "https://github.com/davidbarba-bit/billing2"
    }
  },
  "servers": [
    { "url": "https://billing2-production.up.railway.app", "description": "Railway production" },
    { "url": "http://localhost:3000", "description": "Local dev" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-organization API key emitido por mini-Lago."
      },
      "NetSuiteSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-NetSuite-Signature",
        "description": "Solo usado por NetSuite cuando llama de vuelta a `/external-confirm`. Formato: `sha256=<hex_lowercase>`."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["status", "error", "code"],
        "properties": {
          "status": { "type": "integer", "example": 422 },
          "error": { "type": "string", "example": "Unprocessable Entity" },
          "code": { "type": "string", "example": "validation_errors" },
          "error_details": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": ["current_page", "next_page", "prev_page", "total_pages", "total_count"],
        "properties": {
          "current_page": { "type": "integer" },
          "next_page": { "type": ["integer", "null"] },
          "prev_page": { "type": ["integer", "null"] },
          "total_pages": { "type": "integer" },
          "total_count": { "type": "integer" }
        }
      },
      "Customer": {
        "type": "object",
        "required": ["lago_id", "external_id", "name", "currency", "applicable_timezone"],
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "external_id": { "type": "string" },
          "name": { "type": "string" },
          "sequential_id": { "type": "integer" },
          "slug": { "type": "string" },
          "country": { "type": ["string", "null"] },
          "currency": { "type": "string", "example": "MXN" },
          "tax_identification_number": { "type": ["string", "null"] },
          "timezone": { "type": ["string", "null"], "example": "America/Mexico_City" },
          "applicable_timezone": { "type": "string", "example": "America/Mexico_City" },
          "metadata": { "type": "object", "additionalProperties": true },
          "taxes": { "type": "array", "items": { "$ref": "#/components/schemas/Tax" } }
        }
      },
      "CustomerWriteable": {
        "type": "object",
        "required": ["external_id", "name", "currency"],
        "properties": {
          "external_id": { "type": "string" },
          "name": { "type": "string" },
          "currency": { "type": "string" },
          "country": { "type": "string" },
          "timezone": { "type": "string", "example": "America/Mexico_City" },
          "tax_identification_number": { "type": "string" },
          "tax_codes": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object" }
        }
      },
      "Tax": {
        "type": "object",
        "required": ["lago_id", "code", "name", "rate"],
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "rate": { "type": "number", "example": 16.0 },
          "description": { "type": ["string", "null"] },
          "applied_to_organization": { "type": "boolean" }
        }
      },
      "TaxWriteable": {
        "type": "object",
        "required": ["code", "name", "rate"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "rate": { "oneOf": [{ "type": "string" }, { "type": "number" }], "description": "Aceptado como string o number en write." },
          "description": { "type": "string" },
          "applied_to_organization": { "type": "boolean", "default": false }
        }
      },
      "BillableMetric": {
        "type": "object",
        "required": ["lago_id", "code", "name", "aggregation_type", "recurring"],
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "aggregation_type": { "type": "string", "enum": ["unique_count_agg"] },
          "field_name": { "type": ["string", "null"], "example": "unit_external_id" },
          "recurring": { "type": "boolean" },
          "weighted_interval": { "type": ["string", "null"] }
        }
      },
      "BillableMetricWriteable": {
        "type": "object",
        "required": ["code", "name", "aggregation_type"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "aggregation_type": { "type": "string", "enum": ["unique_count_agg"] },
          "field_name": { "type": "string", "example": "unit_external_id" },
          "recurring": { "type": "boolean", "default": false },
          "weighted_interval": { "type": "string" }
        }
      },
      "ChargeWriteable": {
        "type": "object",
        "required": ["billable_metric_id", "charge_model", "properties"],
        "properties": {
          "billable_metric_id": { "type": "string", "format": "uuid" },
          "charge_model": { "type": "string", "enum": ["standard"] },
          "pay_in_advance": { "type": "boolean" },
          "invoiceable": { "type": "boolean", "default": true },
          "prorated": { "type": "boolean", "description": "Requiere BM.recurring=true" },
          "invoice_display_name": { "type": "string" },
          "properties": {
            "type": "object",
            "required": ["amount"],
            "properties": { "amount": { "type": "string", "example": "450.00" } }
          }
        }
      },
      "Plan": {
        "type": "object",
        "required": ["lago_id", "code", "name", "interval", "amount_currency"],
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "interval": { "type": "string", "enum": ["monthly", "quarterly", "yearly"] },
          "amount_cents": { "type": "integer" },
          "amount_currency": { "type": "string" },
          "pay_in_advance": { "type": "boolean" },
          "bill_charges_monthly": { "type": ["boolean", "null"], "description": "Siempre null cuando interval=monthly" },
          "description": { "type": "string" },
          "charges": { "type": "array", "items": { "$ref": "#/components/schemas/Charge" } }
        }
      },
      "Charge": {
        "type": "object",
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "lago_billable_metric_id": { "type": "string", "format": "uuid" },
          "billable_metric_code": { "type": "string" },
          "charge_model": { "type": "string", "enum": ["standard"] },
          "pay_in_advance": { "type": "boolean" },
          "invoiceable": { "type": "boolean" },
          "prorated": { "type": "boolean" },
          "properties": { "type": "object" }
        }
      },
      "PlanWriteable": {
        "type": "object",
        "required": ["code", "name", "interval", "amount_currency"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "interval": { "type": "string", "enum": ["monthly", "quarterly", "yearly"] },
          "amount_cents": { "type": "integer", "default": 0 },
          "amount_currency": { "type": "string" },
          "pay_in_advance": { "type": "boolean" },
          "bill_charges_monthly": { "type": "boolean" },
          "description": { "type": "string" },
          "charges": { "type": "array", "items": { "$ref": "#/components/schemas/ChargeWriteable" } }
        }
      },
      "Subscription": {
        "type": "object",
        "required": ["lago_id", "external_id", "external_customer_id", "plan_code", "status", "billing_time"],
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "external_id": { "type": "string" },
          "external_customer_id": { "type": "string" },
          "plan_code": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["pending", "active", "terminated", "canceled"] },
          "billing_time": { "type": "string", "enum": ["calendar", "anniversary"] },
          "subscription_at": { "type": ["string", "null"], "format": "date-time" },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "current_billing_period_started_at": { "type": ["string", "null"], "format": "date-time" },
          "current_billing_period_ending_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "SubscriptionWriteable": {
        "type": "object",
        "required": ["external_customer_id", "plan_code", "external_id"],
        "properties": {
          "external_customer_id": { "type": "string" },
          "plan_code": { "type": "string" },
          "external_id": { "type": "string" },
          "name": { "type": "string" },
          "billing_time": { "type": "string", "enum": ["calendar", "anniversary"], "default": "calendar" },
          "subscription_at": { "type": "string", "format": "date-time", "description": "Si es futuro → status=pending" }
        }
      },
      "EventWriteable": {
        "type": "object",
        "required": ["transaction_id", "external_subscription_id", "code", "timestamp"],
        "properties": {
          "transaction_id": { "type": "string", "description": "Único por org; retry con mismo id → 422 value_already_exist." },
          "external_subscription_id": { "type": "string" },
          "code": { "type": "string", "description": "BM code." },
          "timestamp": { "type": "integer", "description": "Unix epoch en SEGUNDOS (mini-Lago rechaza ISO strings → 422 must_be_unix_epoch_seconds)." },
          "properties": {
            "type": "object",
            "properties": {
              "unit_external_id": { "type": "string" },
              "unit_label": { "type": "string" },
              "kind": { "type": "string" },
              "operation_type": { "type": "string", "enum": ["add", "remove"] }
            }
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "transaction_id": { "type": "string" },
          "code": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time", "description": "ISO string (mini-Lago lo convierte de epoch seconds)." },
          "external_subscription_id": { "type": "string" },
          "properties": { "type": "object" }
        }
      },
      "AddOn": {
        "type": "object",
        "required": ["lago_id", "code", "name", "amount_cents", "amount_currency"],
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "invoice_display_name": { "type": ["string", "null"] },
          "amount_cents": { "type": "integer", "minimum": 1 },
          "amount_currency": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "AddOnWriteable": {
        "type": "object",
        "required": ["code", "name", "amount_cents", "amount_currency"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "amount_cents": { "type": "integer", "minimum": 1, "description": "Debe ser > 0." },
          "amount_currency": { "type": "string" },
          "description": { "type": "string" },
          "invoice_display_name": { "type": "string" },
          "tax_codes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "FeeRequest": {
        "type": "object",
        "required": ["add_on_code", "unit_amount_cents", "units"],
        "properties": {
          "add_on_code": { "type": "string" },
          "description": { "type": "string" },
          "unit_amount_cents": { "type": "integer", "minimum": 0 },
          "units": { "type": "string", "description": "String decimal (no number)." }
        }
      },
      "InvoiceWriteable": {
        "type": "object",
        "required": ["external_customer_id", "currency", "fees"],
        "properties": {
          "external_customer_id": { "type": "string" },
          "currency": { "type": "string" },
          "fees": { "type": "array", "items": { "$ref": "#/components/schemas/FeeRequest" } },
          "metadata": {
            "type": "object",
            "properties": {
              "idempotency_key": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "sequential_id": { "type": "integer" },
          "number": { "type": ["string", "null"], "description": "Folio fiscal NetSuite. Null hasta /external-confirm." },
          "status": { "type": "string", "enum": ["calculated", "finalized", "voided"] },
          "external_dispatch_status": { "type": "string", "enum": ["pending", "dispatched", "confirmed", "failed"] },
          "payment_status": { "type": "string", "enum": ["pending", "paid", "overdue", "disputed"] },
          "issuing_date": { "type": "string", "format": "date" },
          "payment_due_date": { "type": "string", "format": "date" },
          "currency": { "type": "string" },
          "fees_amount_cents": { "type": "integer" },
          "taxes_amount_cents": { "type": "integer" },
          "total_amount_cents": { "type": "integer" },
          "customer": { "type": "object" },
          "fees": { "type": "array", "items": { "$ref": "#/components/schemas/Fee" } },
          "units_annex": { "type": "array", "items": { "$ref": "#/components/schemas/UnitsAnnexEntry" } },
          "applied_taxes": { "type": "array", "items": { "type": "object" } },
          "metadata": { "type": "object" }
        }
      },
      "Fee": {
        "type": "object",
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "item": { "type": "object" },
          "amount_cents": { "type": "integer" },
          "taxes_amount_cents": { "type": "integer" },
          "total_amount_cents": { "type": "integer" },
          "units": { "type": "string", "description": "String decimal de 4 dígitos." },
          "precise_unit_amount": { "type": "string" },
          "billed_units_detail": { "type": "array", "items": { "$ref": "#/components/schemas/BilledUnitDetail" } }
        }
      },
      "BilledUnitDetail": {
        "type": "object",
        "required": ["external_id", "billed_fraction", "amount_cents"],
        "properties": {
          "external_id": { "type": "string" },
          "label": { "type": ["string", "null"] },
          "active_from": { "type": "string", "format": "date-time" },
          "active_to": { "type": ["string", "null"], "format": "date-time" },
          "billed_fraction": { "type": "string", "description": "String decimal de 4 dígitos (eg. \"0.6129\")." },
          "amount_cents": { "type": "integer" }
        }
      },
      "UnitsAnnexEntry": {
        "type": "object",
        "properties": {
          "external_id": { "type": "string" },
          "label": { "type": ["string", "null"] },
          "fees": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fee_lago_id": { "type": "string", "format": "uuid" },
                "item_code": { "type": "string" },
                "amount_cents": { "type": "integer" }
              }
            }
          }
        }
      },
      "CreditNoteWriteable": {
        "type": "object",
        "required": ["invoice_id", "reason", "items"],
        "properties": {
          "invoice_id": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "enum": ["duplicated_charge", "product_unsatisfactory", "order_change", "order_cancellation", "fraudulent_charge", "other"] },
          "description": { "type": "string", "description": "Puede llevar marker `[idem:<id>]` para reconciliación." },
          "credit_amount_cents": { "type": "integer", "description": "Tolerancia ±5 cents respecto al cálculo." },
          "refund_amount_cents": { "type": "integer" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["fee_id", "amount_cents"],
              "properties": {
                "fee_id": { "type": "string", "format": "uuid" },
                "amount_cents": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      },
      "CreditNote": {
        "type": "object",
        "properties": {
          "lago_id": { "type": "string", "format": "uuid" },
          "number": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["calculated", "finalized"] },
          "external_dispatch_status": { "type": "string", "enum": ["pending", "dispatched", "confirmed", "failed"] },
          "lago_invoice_id": { "type": "string", "format": "uuid" },
          "invoice_number": { "type": ["string", "null"] },
          "reason": { "type": "string" },
          "description": { "type": "string" },
          "total_amount_cents": { "type": "integer" },
          "taxes_amount_cents": { "type": "integer" },
          "sub_total_excluding_taxes_amount_cents": { "type": "integer" }
        }
      },
      "ExternalConfirmInvoice": {
        "type": "object",
        "required": ["external_invoice"],
        "properties": {
          "external_invoice": {
            "type": "object",
            "required": ["folio"],
            "properties": {
              "folio": { "type": "string" },
              "uuid_cfdi": { "type": "string" },
              "system": { "type": "string", "default": "netsuite" },
              "netsuite_internal_id": { "type": "string" },
              "pdf_url": { "type": "string", "format": "uri" },
              "xml_url": { "type": "string", "format": "uri" },
              "issued_at": { "type": "string", "format": "date-time" },
              "due_date": { "type": "string", "format": "date" }
            }
          }
        }
      },
      "ExternalConfirmCreditNote": {
        "type": "object",
        "required": ["external_credit_note"],
        "properties": {
          "external_credit_note": {
            "type": "object",
            "required": ["folio"],
            "properties": {
              "folio": { "type": "string" },
              "uuid_cfdi": { "type": "string" },
              "system": { "type": "string", "default": "netsuite" },
              "netsuite_internal_id": { "type": "string" },
              "pdf_url": { "type": "string", "format": "uri" },
              "xml_url": { "type": "string", "format": "uri" },
              "issued_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  },
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check (sin auth)",
        "security": [],
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "Server alive",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Este documento OpenAPI (sin auth)",
        "security": [],
        "tags": ["meta"],
        "responses": { "200": { "description": "OpenAPI 3.1 JSON" } }
      }
    },
    "/api/v1": {
      "get": {
        "summary": "Endpoint discovery (sin auth) — lista plana de rutas disponibles",
        "security": [],
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "Lista de endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": { "type": "string", "example": "mini-Lago" },
                    "version": { "type": "string" },
                    "endpoints": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "method": { "type": "string" },
                          "path": { "type": "string" },
                          "summary": { "type": "string" }
                        }
                      }
                    },
                    "openapi": { "type": "string", "example": "/openapi.json" },
                    "docs": { "type": "string", "example": "/docs" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/customers": {
      "post": {
        "summary": "Create / upsert customer por external_id (D1)",
        "tags": ["customers"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "customer": { "$ref": "#/components/schemas/CustomerWriteable" } } } } }
        },
        "responses": {
          "200": { "description": "Customer creado o actualizado", "content": { "application/json": { "schema": { "type": "object", "properties": { "customer": { "$ref": "#/components/schemas/Customer" } } } } } },
          "422": { "description": "Validation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "get": {
        "summary": "List customers (paginado)",
        "tags": ["customers"],
        "parameters": [
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 500 } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": { "description": "Lista", "content": { "application/json": { "schema": { "type": "object", "properties": { "customers": { "type": "array", "items": { "$ref": "#/components/schemas/Customer" } }, "meta": { "$ref": "#/components/schemas/Meta" } } } } } }
        }
      }
    },
    "/api/v1/customers/{externalId}": {
      "get": {
        "summary": "Read customer por external_id",
        "tags": ["customers"],
        "parameters": [{ "name": "externalId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Customer", "content": { "application/json": { "schema": { "type": "object", "properties": { "customer": { "$ref": "#/components/schemas/Customer" } } } } } },
          "404": { "description": "customer_not_found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "put": {
        "summary": "PUT → 404 resource_not_found (invariante #11; usa POST upsert)",
        "tags": ["customers"],
        "parameters": [{ "name": "externalId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "404": { "description": "resource_not_found" } }
      }
    },
    "/api/v1/customers/{externalId}/current_usage": {
      "get": {
        "summary": "Usage acumulado del periodo abierto",
        "tags": ["customers"],
        "parameters": [
