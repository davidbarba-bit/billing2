# Numaris Billing environment variables.

# Server.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Postgres connection used by Prisma.
DATABASE_URL=postgresql://numaris:numaris@localhost:5432/numaris_billing?schema=public

# Feature flags.
# When false the NetSuite outbound dispatcher is short-circuited: invoices
# transition straight to `external_dispatch_status=dispatched` after a fake
# acknowledgement is recorded. When true the real OAuth 1.0/TBA pipeline is
# used (per-organization credentials are read from the `organization` table).
FEATURE_NETSUITE_DISPATCH_ENABLED=false

# When true the NetSuite callback (#15, #15b) enforces mTLS in addition to
# the always-on HMAC-SHA256 signature. The mTLS layer is optional per D12.
FEATURE_NETSUITE_CALLBACK_MTLS=false

# Comma-separated IP allowlist for the NetSuite callback (D12 layer 3).
# Empty disables IP enforcement (recommended only for sandbox).
NETSUITE_CALLBACK_IP_ALLOWLIST=

# Period roll-over cron (D9). Default runs every 15 minutes; expressed as a
# crontab expression.
PERIOD_ROLLOVER_CRON=*/15 * * * *
PERIOD_ROLLOVER_ENABLED=true

# Bootstrap. When the server starts and the org table is empty it seeds a
# default organization + API key using these values. Real production
# deployments should run a dedicated migration instead.
SEED_DEFAULT_ORG_SLUG=NUM-FC2D
SEED_DEFAULT_ORG_TIMEZONE=America/Mexico_City
SEED_DEFAULT_API_KEY=dev-api-key-replace-me

# Admin back-office auth (v16).
#
#   ADMIN_AUTH_MODE=basic  → HTTP Basic Auth con ADMIN_USER/ADMIN_PASSWORD (default).
#   ADMIN_AUTH_MODE=google → Google OAuth2 + sesión por cookie firmada. Solo
#     emails @ADMIN_ALLOWED_EMAIL_DOMAIN (default numaris.com). Requiere:
#       - GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_CLIENT_SECRET (de Google Cloud Console).
#       - SESSION_SECRET (≥ 32 caracteres, ej: openssl rand -base64 48).
#       - CALLBACK_BASE_URL apuntando a la URL pública (ej. https://billing.numaris.com).
#     Setup en Google Cloud: crea OAuth 2.0 Client ID (Web app) con Authorized
#     redirect URI = ${CALLBACK_BASE_URL}/admin/auth/callback. En el OAuth consent
#     screen, User Type = Internal si el dominio es Google Workspace.
#
# Basic auth se mantiene como break-glass de emergencia: si Google OAuth se
# rompe, pon ADMIN_AUTH_MODE=basic y redeploy para recuperar acceso.
ADMIN_AUTH_MODE=basic
ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_ALLOWED_EMAIL_DOMAIN=numaris.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# Programmatic hard reset (POST /api/v1/admin/reset). Wipes ALL data rows
# for the authenticated organization, preserving the org row + api_key.
# If unset, the endpoint returns 403 admin_reset_disabled (fail-closed).
# Set to a strong random string in any environment where you want the
# endpoint enabled.
ADMIN_RESET_TOKEN=
