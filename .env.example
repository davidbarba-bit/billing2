# mini-Lago environment variables.

# Server.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Postgres connection used by Prisma.
DATABASE_URL=postgresql://minilago:minilago@localhost:5432/minilago?schema=public

# Feature flags.
# When false the NetSuite outbound dispatcher is short-circuited: invoices
# transition straight to `external_dispatch_status=dispatched` after a fake
# acknowledgement is recorded. When true the real OAuth 1.0/TBA pipeline is
# used (per-organization credentials are read from the `organization` table).
FEATURE_NETSUITE_DISPATCH_ENABLED=false

# When true the NetSuite callback (#15, #15b) enforces mTLS in addition to
# the always-on HMAC-SHA256 signature. The mTLS layer is optional per D12.
FEATURE_NETSUITE_CALLBACK_MTLS=false

# Comma-separated IP allowlist for the NetSuite callback (D12 layer 3).
# Empty disables IP enforcement (recommended only for sandbox).
NETSUITE_CALLBACK_IP_ALLOWLIST=

# Period roll-over cron (D9). Default runs every 15 minutes; expressed as a
# crontab expression.
PERIOD_ROLLOVER_CRON=*/15 * * * *
PERIOD_ROLLOVER_ENABLED=true

# Bootstrap. When the server starts and the org table is empty it seeds a
# default organization + API key using these values. Real production
# deployments should run a dedicated migration instead.
SEED_DEFAULT_ORG_SLUG=NUM-FC2D
SEED_DEFAULT_ORG_TIMEZONE=America/Mexico_City
SEED_DEFAULT_API_KEY=dev-api-key-replace-me

# Admin back-office (HTTP Basic Auth at /admin). Change before exposing the
# admin beyond localhost.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
